[run]
source = .
# Branch coverage stays ON.
#
# Turning it off was measured as a real speedup (on a 743-test subset, CPU went
# 19.73s -> 17.93s statement-only, and 13.47s with COVERAGE_CORE=sysmon on top),
# but it BREAKS the JSON report in this repo: coverage's own
# jsonreport.report_one_file -> PythonFileReporter.code_regions() raises a
# SyntaxError mid-report, pytest aborts with INTERNALERROR, and no coverage.json
# is written at all -- so fail_under below is never evaluated either.
#
# Reproduced on the full offline suite, twice each, same machine, `-p
# no:randomly` so ordering is fixed:
#     branch = True,  default core  -> 0 INTERNALERROR, coverage.json written
#     branch = True,  sysmon        -> 0 INTERNALERROR, coverage.json written
#     branch = False, default core  -> 59 INTERNALERROR, no coverage.json
#     branch = False, sysmon        -> INTERNALERROR,    no coverage.json
#
# No file in the repo reproduces it in isolation (code_regions() was run over
# every tracked .py: 0 failures), so the offending source is generated during
# the run -- consistent with the reported `File "<unknown>", line 11`. Don't
# flip this without re-running the full suite and confirming coverage.json is
# actually produced.
branch = True
omit =
    tests/*
    .venv/*
    */__pycache__/*
    gravity/*
    scripts/*
    setup.py
    conftest.py
    */conftest.py
    # legacy/streamlit_command_center/* is the frozen, decommissioned
    # Streamlit "InvestYo Command Center" + native-shell archive (see
    # CLAUDE.md's "Frontend strategy" section) -- no new tabs/panels/
    # capability, so its coverage number will never move again except to
    # drift downward as the rest of the platform changes around it. Unlike
    # the earlier documented decision to NOT add a gui/panels/* omit
    # (docs/test_coverage_analysis.md's ".coveragerc vs. this doc's own
    # stated intent" section -- made while that code was still being
    # actively extracted/tested), that concern no longer applies once the
    # code is explicitly frozen: there is no more "keep the pressure on to
    # write more tests" signal to protect. Omitting it keeps `fail_under`
    # a real regression gate on the actively-developed engine/signal/
    # execution/webapp code, not a number a frozen archive can silently
    # drag down over time.
    legacy/*

[report]
show_missing = True
skip_covered = True
# Coverage-floor ratchet (docs/test_coverage_analysis.md Phase 5 item 8).
# Measured whole-suite total at the time this was added: 61% (`pytest -m
# "not network" --cov`, 2026-07-14, after the Phase 5 test-coverage pass).
# Set a few points below that measured baseline, not the baseline itself,
# so ordinary coverage-neutral PRs and minor measurement noise (branch
# coverage of conditionally-imported optional deps, etc.) don't fail CI --
# this exists to catch a real regression, not to block unrelated work.
# Raise this number as coverage improves; never lower it to paper over a
# real drop.
fail_under = 58

[json]
output = coverage.json
