{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "default_api:write_to_file|default_api:replace_file_content|default_api:multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "bash .agents/hooks/block_env_write.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .agents/hooks/stop_test.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
