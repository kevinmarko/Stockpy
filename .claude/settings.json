{
  "permissions": {
    "allow": [
      "Bash(source .venv/bin/activate *)",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__find",
      "Bash(npm run typecheck *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git worktree *)",
      "Bash(git rev-list *)",
      "Bash(gh run *)",
      "Bash(./setup.sh)",
      "Bash(.venv/bin/python --version)",
      "Bash(.venv/bin/pip list *)",
      "Bash(.venv/bin/python -m pytest tests/ -q -p no:cacheprovider --tb=no)",
      "Bash(.venv/bin/python -m pytest tests/ -q -p no:cacheprovider --tb=short)",
      "Bash(npx --version)",
      "mcp__robinhood-trading__get_equity_positions",
      "mcp__robinhood-trading__get_portfolio",
      "mcp__robinhood-trading__get_scans"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block_env_write.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/webapp_typecheck.sh",
            "timeout": 60,
            "statusMessage": "Typechecking webapp..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/verify_targeted_tests.sh",
            "timeout": 90,
            "statusMessage": "Running targeted tests..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sync_agent_docs.sh",
            "timeout": 15,
            "statusMessage": "Syncing CLAUDE.md/AGENTS.md..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sync_launch_json.sh",
            "timeout": 15,
            "statusMessage": "Syncing launch.json..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify_before_stop.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
